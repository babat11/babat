# RightsAI Nigeria — environment configuration example
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- App ---
APP_NAME=RightsAI Nigeria
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- CORS ---
# Comma-separated list of allowed origins, or "*" for all.
CORS_ORIGINS=*

# --- OpenAI / LLM ---
# If OPENAI_API_KEY is left blank, the service runs in offline (deterministic,
# rule-based) mode so you can develop and test without a key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2

# --- Database / pgvector (placeholders for future RAG integration) ---
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/rightsai
